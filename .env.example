# ============================================================
# Badir Legal AI Platform — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ─── APPLICATION ─────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=http://localhost:3000
# For production with domain:
# FRONTEND_URL=https://dashboard.your-domain.com

# ─── SECURITY ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_64_CHARS_MIN
JWT_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_STRING_64_CHARS_MIN
JWT_EXPIRES_IN=8h

# ─── DATABASE (PostgreSQL) ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_dashboard
POSTGRES_SCHEMA=auth
POSTGRES_USER=legal_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# With password (recommended for production):
# REDIS_URL=redis://:your_redis_password@localhost:6379

# ─── AI SERVICES ─────────────────────────────────────────────
# Use container names when running inside Docker network
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=3

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=account_legal_docs

# ─── N8N WEBHOOK ─────────────────────────────────────────────
# Get this from your n8n workflow trigger node
N8N_WEBHOOK_URL=http://localhost:5678/webhook/YOUR_WEBHOOK_ID_HERE
N8N_WEBHOOK_SECRET=CHANGE_THIS_IF_USING_WEBHOOK_AUTH

# ─── NEXTCLOUD ───────────────────────────────────────────────
NEXTCLOUD_BASE_URL=http://localhost:8080
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_THIS_NEXTCLOUD_PASSWORD
NEXTCLOUD_DOCS_PATH=/var/www/html/data/YOUR_USER/files/

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
# For production:
# CORS_ORIGIN=https://dashboard.your-domain.com

# ─── RATE LIMITING ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=info
# Options: error | warn | info | debug
